allow hal_sensors_default sensors_device:chr_file rw_file_perms;
allow hal_sensors_default vendor_fingerprint_sysfs:file rw_file_perms;

# Touchfeature and input monitoring for single-tap
allow hal_sensors_default touchfeature_device:chr_file rw_file_perms;
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file r_file_perms;

get_prop(hal_sensors_default, vendor_sensors_prop)
